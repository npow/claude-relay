#!/usr/bin/env bash
set -euo pipefail

unset ANTHROPIC_API_KEY
export ANTHROPIC_BASE_URL="${AGENT_RELAY_URL:-http://127.0.0.1:18082}"
export ANTHROPIC_AUTH_TOKEN="unused"
export ANTHROPIC_MODEL="${AGENT_RELAY_MODEL:-gpt-5.6-sol}"
export ANTHROPIC_CUSTOM_MODEL_OPTION="$ANTHROPIC_MODEL"
export ANTHROPIC_CUSTOM_MODEL_OPTION_NAME="GPT-5.6 SOL"
export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY="1"

exec claude --dangerously-skip-permissions "$@"
